<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    tools:context=".MainActivity">

    <ImageView
        android:id="@+id/image_map"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_marginBottom="150dp"
        android:src="@drawable/map"/>

    <SeekBar
        android:id="@+id/seek_map"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_above="@id/bottom_navigation"
        android:layout_margin="16dp"
        android:max="100"
        android:progress="50" />

    <ImageView
        android:id="@+id/image_apps"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_marginBottom="90dp"
        android:src="@drawable/apps"
        android:visibility="gone" />

    <RatingBar
        android:id="@+id/rating_apps"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_above="@id/bottom_navigation"
        android:layout_centerHorizontal="true"
        android:numStars="5"
        android:progressTint="#FFC107"
        android:progressBackgroundTint="#BDBDBD"
        android:rating="0"
        android:stepSize="1"
        android:visibility="gone" />

    <ImageView
        android:id="@+id/image_mail"
        android:layout_width="240dp"
        android:layout_height="240dp"
        android:layout_centerInParent="true"
        android:src="@drawable/icon_mail"
        android:visibility="gone" />

    <LinearLayout
        android:id="@+id/mail_controls"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_above="@id/bottom_navigation"
        android:layout_margin="16dp"
        android:gravity="center_horizontal"
        android:orientation="vertical"
        android:visibility="gone">

        <EditText
            android:id="@+id/edittext_mail"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="Впишите почту"/>

        <CheckBox
            android:id="@+id/checkbox_copy"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Отправить копию себе" />

        <Button
            android:id="@+id/button_send"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Отправить" />
    </LinearLayout>

    <com.google.android.material.bottomnavigation.BottomNavigationView
        android:id="@+id/bottom_navigation"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_alignParentBottom="true"
        app:itemBackground="@color/colorPrimary"
        app:itemIconTint="@color/bottom_navigation_item_background_colors"
        app:itemTextColor="@color/bottom_navigation_item_background_colors"
        app:menu="@menu/menu_bottom_navigation"/>

</RelativeLayout>